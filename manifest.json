{
  "manifest_version": 3,
  "name": "ShieldBlock Pro",
  "version": "2.21.1",
  "description": "Block ads, trackers, and cookie banners across the web. Privacy protection and fingerprint resistance built in.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "scripting",
    "webNavigation",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/inject-privacy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-privacy.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-cookies.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-annoyances.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-general.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/scriptlets.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-procedural.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.twitch.tv/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*"
      ],
      "js": [
        "src/inject-twitch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.twitch.tv/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-twitch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://open.spotify.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-spotify.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.hulu.com/*",
        "*://hulu.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-hulu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://kick.com/*",
        "*://www.kick.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-kick.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/inject-youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base_rules",
        "enabled": true,
        "path": "rules/base.json"
      },
      {
        "id": "extended_rules",
        "enabled": true,
        "path": "rules/extended.json"
      },
      {
        "id": "tracking_rules",
        "enabled": true,
        "path": "rules/tracking.json"
      },
      {
        "id": "hosts_rules",
        "enabled": true,
        "path": "rules/hosts.json"
      },
      {
        "id": "easylist_static",
        "enabled": true,
        "path": "rules/easylist-static.json"
      },
      {
        "id": "easyprivacy_static",
        "enabled": true,
        "path": "rules/easyprivacy-static.json"
      },
      {
        "id": "easylistgermany_static",
        "enabled": true,
        "path": "rules/easylistgermany-static.json"
      },
      {
        "id": "peterlowe_static",
        "enabled": true,
        "path": "rules/peterlowe-static.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open ShieldBlock popup"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Toggle blocking on current site"
    },
    "activate-picker": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Activate element picker"
    }
  },
  "homepage_url": "https://shieldblock.pro/",
  "browser_specific_settings": {
    "gecko": {
      "id": "shieldblock-pro@shieldblock.ext",
      "strict_min_version": "128.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "welcome.html",
        "src/blank.js",
        "rules/base.json",
        "rules/extended.json",
        "rules/tracking.json",
        "rules/hosts.json",
        "src/filter-catalog.json",
        "src/cosmetic.css",
        "src/trusted-sites.js",
        "src/stubs/noop-adsbygoogle.js",
        "src/stubs/noop-gpt.js",
        "src/stubs/noop-ga.js",
        "src/stubs/noop-gtag.js",
        "src/stubs/noop-apstag.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
