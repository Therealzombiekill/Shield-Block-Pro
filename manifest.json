{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.10.1",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "scripting",
    "webNavigation",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "dns",
    "webRequest",
    "webRequestBlocking"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/inject-privacy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.in/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.es/*",
        "*://*.amazon.it/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.nl/*",
        "*://*.amazon.pl/*",
        "*://*.amazon.se/*",
        "*://*.amazon.sg/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-amazon.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-cookies.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-general.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.old.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.linkedin.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/tiktok-ads.js",
        "src/content-social.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/scriptlets.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-procedural.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.twitch.tv/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*"
      ],
      "js": [
        "src/inject-twitch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.twitch.tv/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-twitch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://open.spotify.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-spotify.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.hulu.com/*",
        "*://hulu.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-hulu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://kick.com/*",
        "*://www.kick.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-kick.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/inject-youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/browser-compat.js",
        "src/content-paywall.js"
      ],
      "run_at": "document_idle",
      "match_about_blank": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base_rules",
        "enabled": true,
        "path": "rules/base.json"
      },
      {
        "id": "extended_rules",
        "enabled": true,
        "path": "rules/extended.json"
      },
      {
        "id": "tracking_rules",
        "enabled": true,
        "path": "rules/tracking.json"
      },
      {
        "id": "hosts_rules",
        "enabled": true,
        "path": "rules/hosts.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open ShieldBlock popup"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Toggle blocking on current site"
    },
    "activate-picker": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Activate element picker"
    }
  },
  "homepage_url": "https://astonishing-swan-da7249.netlify.app/",
  "browser_specific_settings": {
    "gecko": {
      "id": "shieldblock-pro@shieldblock.ext",
      "strict_min_version": "128.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "welcome.html",
        "src/blank.js",
        "rules/base.json",
        "rules/extended.json",
        "rules/tracking.json",
        "rules/hosts.json",
        "src/filter-catalog.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}